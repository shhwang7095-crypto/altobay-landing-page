# Copy this file to .env.local and fill in real values for local development.
# In production (Firebase App Hosting), these are set as secrets referenced
# from apphosting.yaml — see HANDOFF.md for the exact setup steps.

# Notion integration secret (from notion.so/my-integrations)
NOTION_API_KEY=

# The database the /demo form writes to (32-char ID from the database URL)
NOTION_DATABASE_ID=
